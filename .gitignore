node_modules/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.cache/
*.log
*.tmp
*.temp
*.swp
*.swo
~$*

# Operating system metadata.
.DS_Store
Thumbs.db
Desktop.ini

